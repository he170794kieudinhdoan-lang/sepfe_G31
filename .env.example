
# API Configuration
VITE_API_URL=http://localhost:4000/api

# App Configuration
VITE_APP_TITLE=WORKLINK
VITE_ENABLE_MOCK=true
VITE_AUTH_SOCIAL_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
VITE_PROVINCES_API_URL=https://provinces.open-api.vn/api/v2
AUTH_SOCIAL_GOOGLE_CLIENT_SECRET=your-google-client-secret

# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Realtime - Notifications
VITE_NOTIFICATION_REALTIME_SCHEMA=public
VITE_NOTIFICATION_REALTIME_TABLE=Notification
VITE_NOTIFICATION_REALTIME_USER_COLUMN=userId

# Realtime - Point Pricing (SystemSetting table)
VITE_POINT_PRICING_REALTIME_SCHEMA=public
VITE_POINT_PRICING_REALTIME_TABLE=SystemSetting

# Realtime - Payment Order Status
VITE_PAYMENT_ORDER_REALTIME_SCHEMA=public
VITE_PAYMENT_ORDER_REALTIME_TABLE=PaymentOrder
